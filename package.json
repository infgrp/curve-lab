{
  "name": "curve-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "곡선 찾기 실험실 — 교육연구정보원(전북) 체험센터 키오스크용 웹 앱",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.0",
    "wrangler": "4.131.0"
  }
}
